{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Asset Plan",
  "description": "S2 的唯一输入：每个资产的等级、来源、生产路线与验收阈值。build_assets.py 消费此文件。",
  "type": "object",
  "required": ["version", "assets"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "grade": { "enum": ["prototype", "production", "hero"], "default": "production" },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["local", "fal", "replicate", "comfyui", "manual", "none"] },
          "model": { "type": "string" },
          "endpoint": { "type": "string" },
          "command": {
            "type": "string",
            "description": "kind=local/manual 时执行的命令模板，可用 {prompt} {out} {ref} {seed}"
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "tier"],
        "properties": {
          "id": { "type": "string", "pattern": "^(chr|prop|env)_[a-z0-9_]+$" },
          "kind": { "enum": ["character", "prop", "location"] },
          "tier": { "enum": ["T0", "T1", "T2", "T3"] },
          "route": { "enum": ["vrm", "cc0", "image-to-3d", "scan", "procedural", "hybrid"] },
          "prompt": { "type": "string" },
          "refs": { "type": "array", "items": { "type": "string" } },
          "seed": { "type": "integer" },
          "out": { "type": "string", "description": "相对项目根的输出路径" },
          "size": {
            "type": "array", "minItems": 3, "maxItems": 3,
            "items": { "type": "number" }, "description": "米制包围盒 [x,y,z]"
          },
          "targetTris": { "type": "integer" },
          "texelDensity": { "type": "integer" },
          "maps": { "type": "array", "items": { "type": "string" } },
          "rig": { "enum": ["none", "humanoid", "custom"] },
          "blendshapes": { "type": "integer" },
          "license": { "type": "string" },
          "derivedFrom": { "type": "array", "items": { "type": "string" } },
          "lock": { "type": "string", "description": "可原样粘贴的连续性锁" }
        }
      }
    }
  }
}
